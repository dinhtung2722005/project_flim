/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model audit_exports {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requester_user_id  String     @db.Uuid
  operation_id       String     @unique @db.Uuid
  scope_filter       Json
  status             String     @default("QUEUED")
  private_object_ref String?
  checksum_sha256    String?    @db.VarChar(64)
  created_at         DateTime   @default(now()) @db.Timestamptz(6)
  ready_at           DateTime?  @db.Timestamptz(6)
  expires_at         DateTime?  @db.Timestamptz(6)
  operations         operations @relation(fields: [operation_id], references: [id], onUpdate: NoAction)
  users              users      @relation(fields: [requester_user_id], references: [id], onUpdate: NoAction)

  @@index([expires_at], map: "audit_exports_expiry_idx", where: raw("(status = 'READY'::text)"))
  @@index([requester_user_id, created_at(sort: Desc)], map: "audit_exports_requester_idx")
  @@schema("movie")
}

