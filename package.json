{
  "name": "pj-flim",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ts-node --project apps/api/tsconfig.json apps/api/src/main.ts",
    "build": "tsc -p apps/api/tsconfig.json",
    "start": "node dist/apps/api/src/main.js",
    "typecheck": "tsc -p apps/api/tsconfig.json --noEmit",
    "db:introspect": "node scripts/introspect.mjs",
    "db:generate": "prisma generate",
    "admin:bootstrap": "ts-node --project apps/api/tsconfig.json scripts/bootstrap-admin.ts",
    "api:configure": "node scripts/configure-api.mjs",
    "test:integration": "ts-node --project apps/api/tsconfig.json tests/admin.integration.ts",
    "openapi:export": "ts-node --project apps/api/tsconfig.json scripts/export-openapi.ts",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css,json,html}\" \"packages/**/*.ts\" \"scripts/*.{ts,mjs}\" \"tests/**/*.ts\" package.json tsconfig.json apps/api/tsconfig.json prisma.config.ts",
    "cloudinary:configure": "ts-node --project apps/api/tsconfig.json scripts/configure-cloudinary.ts",
    "cloudinary:smoke": "ts-node --project apps/api/tsconfig.json scripts/cloudinary-smoke.ts",
    "worker:configure": "node scripts/configure-worker.mjs",
    "worker:dev": "ts-node --project apps/worker/tsconfig.json apps/worker/src/main.ts",
    "worker:start": "node dist/apps/worker/src/main.js",
    "worker:smoke": "ts-node --project apps/worker/tsconfig.json scripts/worker-smoke.ts",
    "playback:smoke": "ts-node --project apps/api/tsconfig.json scripts/playback-smoke.ts",
    "web:dev": "npm --workspace @pj-flim/web run dev",
    "web:build": "npm --workspace @pj-flim/web run build",
    "web:typecheck": "npm --workspace @pj-flim/web run typecheck",
    "build:all": "npm run build && npm run web:build",
    "test:web": "node scripts/test-web.mjs",
    "streaming:smoke": "ts-node --project apps/api/tsconfig.json scripts/live-streaming-smoke.ts",
    "rabbitmq:smoke": "ts-node --project apps/worker/tsconfig.json scripts/rabbitmq-smoke.ts"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1165.0",
    "@aws-sdk/lib-storage": "^3.1165.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@node-rs/argon2": "^2.0.0",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "amqplib": "^2.3.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cloudinary": "^2.11.0",
    "dotenv": "^17.0.0",
    "helmet": "^8.0.0",
    "nodemailer": "^10.5.0",
    "otpauth": "^9.0.0",
    "pg": "^8.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@types/amqplib": "^0.10.8",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.0.0",
    "@types/supertest": "^6.0.0",
    "prettier": "^3.0.0",
    "prisma": "^7.0.0",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  },
  "workspaces": [
    "apps/web"
  ]
}
