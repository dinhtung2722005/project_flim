# Real local connection URLs are generated in .env.database.local.
# schema=movie is a Prisma URL option, not a libpq/psql option.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=pj_flim
DATABASE_SCHEMA=movie
DATABASE_URL=postgresql://pj_flim_api:REPLACE_WITH_GENERATED_PASSWORD@127.0.0.1:5432/pj_flim?schema=movie
WORKER_DATABASE_URL=postgresql://pj_flim_worker:REPLACE_WITH_GENERATED_PASSWORD@127.0.0.1:5432/pj_flim?schema=movie
MIGRATION_DATABASE_URL=postgresql://pj_flim_owner:REPLACE_WITH_GENERATED_PASSWORD@127.0.0.1:5432/pj_flim?schema=movie
