NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
SWAGGER_ENABLED=true
# Set false for local password-only admin login. Production always requires MFA.
AUTH_MFA_REQUIRED=true
# JWT_SECRET and CURSOR_SECRET need at least 64 characters; generate random keys with npm run api:configure.
JWT_SECRET=GENERATE_WITH_NPM_RUN_API_CONFIGURE
MFA_ENCRYPTION_KEY=GENERATE_WITH_NPM_RUN_API_CONFIGURE
CURSOR_SECRET=GENERATE_WITH_NPM_RUN_API_CONFIGURE

# Cloudinary: keep the API secret in .env.api.local only.
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_API_KEY
CLOUDINARY_API_SECRET=YOUR_API_SECRET
CLOUDINARY_UPLOAD_PRESET=pj_flim_video_signed
CLOUDINARY_MAX_VIDEO_BYTES=104857600
CLOUDINARY_MAX_VIDEO_SECONDS=21600
CLOUDINARY_STREAMING_PROFILE=hd

# Viewer playback: current signed CDN URLs do not expire with API sessions.
ALLOW_GUEST_PLAYBACK=true
PLAYBACK_ALLOW_NON_EXPIRING_URLS=false

# Local email stays under .local and is never served by the API.
# Production requires MAIL_TRANSPORT=smtp and explicit SMTP credentials.
MAIL_TRANSPORT=local
MAIL_LOCAL_ROOT=.local/mail
MAIL_FROM=no-reply@pj-flim.local
# SMTP_HOST=YOUR_SMTP_HOST
# SMTP_PORT=465
# SMTP_USER=YOUR_SMTP_USER
# SMTP_PASSWORD=YOUR_SMTP_PASSWORD
