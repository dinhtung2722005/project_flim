# Generate local credentials with npm.cmd run worker:configure.
RABBITMQ_URL=amqp://WORKER_USER:WORKER_PASSWORD@127.0.0.1:5672/pj_flim
RABBITMQ_PREFIX=pjflim.media
WORKER_PREFETCH=2
WORKER_LEASE_SECONDS=120
WORKER_POLL_MS=1000
MEDIA_RECONCILE_SECONDS=20
MEDIA_MAX_WAIT_SECONDS=7200
MEDIA_MAX_FAILURES=8
MEDIA_CALLBACK_SECRET=GENERATE_64_HEX_CHARACTERS
CLOUDINARY_WEBHOOK_URL=https://YOUR_DOMAIN/api/v1/webhooks/cloudinary
# Development: private local backup. Production requires independent S3.
BACKUP_DRIVER=filesystem
BACKUP_LOCAL_ROOT=E:/pj-Flim/.local/backups
BACKUP_BUCKET=
BACKUP_REGION=ap-southeast-1
BACKUP_S3_ENDPOINT=
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=
