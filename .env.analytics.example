# Generate a stable private key with npm.cmd run analytics:configure.
ANALYTICS_HASH_SECRET=GENERATE_64_HEX_WITH_ANALYTICS_CONFIGURE
ANALYTICS_QUEUE_PREFIX=pjflim.analytics
# Optional ANALYTICS_RABBITMQ_URL; defaults to RABBITMQ_URL from .env.worker.local.
# WORKER_DATABASE_URL comes from .env.database.local. Never use DATABASE_URL here.
